Project CommanderCompanion {
  database_type: 'PostgreSQL'
  Note: 'Esquema de base de datos para Commander Companion'
}

Table users {
  id uuid [primary key]
  username varchar [unique, not null]
  email varchar [unique, not null]
  password_hash varchar [note: 'Nullable: cuentas creadas vía Google no tienen password']
  google_id varchar [unique, note: 'Sub de Google (id_token). Nullable: cuentas email/password no lo tienen']
  created_at timestamp [default: `now()`]
  updated_at timestamp
  moxfield_username varchar [note: 'Username de Moxfield vinculado (opcional, sin unicidad). Migración 00009_moxfield_username.sql']
  email_verified boolean [default: true, note: 'Default true: cuentas existentes y altas de Google (ya confirmadas por su id_token) quedan verificadas. Solo el alta email/password fuerza false. Migración 00011_email_verification.sql']

  Note: 'CHECK: password_hash IS NOT NULL OR google_id IS NOT NULL'
}

Table refresh_tokens {
  id uuid [primary key]
  user_id uuid [ref: > users.id]
  token_hash varchar [unique, not null, note: 'SHA-256 del refresh token; el token en claro nunca se persiste']
  expires_at timestamp [not null]
  created_at timestamp [default: `now()`]
  revoked_at timestamp [note: 'Se setea en logout o al rotar el token']
}

Table email_verification_tokens {
  id uuid [primary key]
  user_id uuid [ref: > users.id]
  token_hash varchar [unique, not null, note: 'SHA-256 del token de verificación; el token en claro nunca se persiste']
  expires_at timestamp [not null]
  created_at timestamp [default: `now()`]
  used_at timestamp [note: 'Se setea al verificar el email con este token (uso único). Migración 00011_email_verification.sql']
}

Table decks {
  id uuid [primary key]
  user_id uuid [ref: > users.id]
  name varchar [not null]
  commander varchar [not null]
  moxfield_id varchar
  image_url varchar [note: 'Art crop del comandante (Moxfield), migración 00006_deck_image_url.sql']
  created_at timestamp [default: `now()`]
  updated_at timestamp

  indexes {
    moxfield_id [note: 'Lookup/de-dup de imports de Moxfield (migración 00003_indices.sql)']
  }
}

Table playgroups {
  id uuid [primary key]
  name varchar [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
}

Table playgroup_members {
  playgroup_id uuid [ref: > playgroups.id]
  user_id uuid [ref: > users.id]
  joined_at timestamp [default: `now()`]

  indexes {
    (playgroup_id, user_id) [pk]
  }
}

Table games {
  id uuid [primary key]
  playgroup_id uuid [ref: > playgroups.id, null, note: 'Opcional si la partida pertenece a un grupo']
  status varchar [not null, note: 'pending, active, finished']
  started_at timestamp
  finished_at timestamp
  created_at timestamp [default: `now()`]
  current_turn_player_id uuid [ref: > game_players.id, null, note: 'De quién es el turno ahora (no modela orden de turno). Migración 00008_current_turn.sql']

  Note: 'CHECK: status IN (\'pending\', \'active\', \'finished\') (migración 00004_status_constraints.sql)'
}

Table game_players {
  id uuid [primary key]
  game_id uuid [ref: > games.id]
  user_id uuid [ref: > users.id]
  deck_id uuid [ref: > decks.id]
  life_total int [default: 40]
  poison_counters int [default: 0]
  energy_counters int [default: 0]
  experience_counters int [default: 0]
  is_eliminated boolean [default: false]
  added_by uuid [ref: > users.id, null, note: 'Quién lo unió si no fue él mismo (proxy-join en modo Grupo, ver ADR-0013). Migración 00012_game_player_proxy_join.sql']

  indexes {
    game_id [note: 'Hot path de lectura de jugadores de una partida (migración 00003_indices.sql)']
  }
}

Table game_actions {
  id uuid [primary key]
  game_id uuid [ref: > games.id]
  actor_id uuid [ref: > game_players.id, note: 'Quién realiza o es el origen de la acción']
  target_id uuid [ref: > game_players.id, note: 'Sobre quién se realiza (opcional)']
  action_type varchar [not null, note: 'Ej: LifeChange, CombatDamage, CommanderDamage, PoisonCounter, TurnStart, TurnEnd, Elimination']
  payload jsonb [note: 'Ej para CommanderDamage: {"amount": 7, "commander_deck_id": "uuid"}']
  created_at timestamp [default: `now()`]

  indexes {
    game_id [note: 'Hot path de lectura del timeline de una partida (migración 00003_indices.sql)']
  }

  Note: 'CHECK: action_type IN (\'LifeChange\', \'CombatDamage\', \'CommanderDamage\', \'PoisonCounter\', \'TurnStart\', \'TurnEnd\', \'Elimination\') (migración 00004_status_constraints.sql)'
}

Table commander_damage {
  game_id uuid [ref: > games.id]
  attacker_id uuid [ref: > game_players.id, note: 'Jugador cuyo comandante infligió el daño']
  defender_id uuid [ref: > game_players.id, note: 'Jugador que recibió el daño']
  amount int [not null, default: 0, note: 'Acumulado de daño de este atacante a este defensor en la partida']

  indexes {
    (attacker_id, defender_id) [pk]
    game_id [note: 'Migración 00007_commander_damage.sql']
  }

  Note: 'CHECK: attacker_id <> defender_id, amount >= 0 (migración 00007_commander_damage.sql). 21+ de un mismo attacker_id elimina al defender_id (regla real de Commander), independiente de game_players.life_total'
}

// Estadísticas pre-calculadas (se recalculan si una partida histórica se modifica)
Table user_statistics_summary {
  user_id uuid [primary key, ref: - users.id]
  games_played int [default: 0]
  games_won int [default: 0]
  total_damage_dealt int [default: 0]
  total_commander_damage_dealt int [default: 0]
  total_eliminations int [default: 0]
  last_recalculated_at timestamp [default: `now()`]
}

Table deck_statistics_summary {
  deck_id uuid [primary key, ref: - decks.id]
  games_played int [default: 0]
  games_won int [default: 0]
  highest_life_total_achieved int [default: 0]
  total_commander_damage_dealt int [default: 0]
  last_recalculated_at timestamp [default: `now()`]
}

// Import masivo y asíncrono de todos los decks públicos de un usuario de Moxfield
// (ver internal/moxfieldimport). Contadores agregados, no un ítem por deck.
Table moxfield_import_jobs {
  id uuid [primary key]
  user_id uuid [ref: > users.id]
  moxfield_username varchar [not null]
  status varchar [not null, default: 'pending', note: 'pending, in_progress, completed, failed']
  total_decks int [null]
  imported_count int [default: 0]
  failed_count int [default: 0]
  error_message varchar [null]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  finished_at timestamp

  indexes {
    (user_id) [name: 'moxfield_import_jobs_active_user_idx', note: 'UNIQUE parcial WHERE status IN (pending, in_progress) -- un solo job activo por usuario. Migración 00010_moxfield_import_jobs.sql']
  }

  Note: 'CHECK: status IN (\'pending\', \'in_progress\', \'completed\', \'failed\') (migración 00010_moxfield_import_jobs.sql)'
}
