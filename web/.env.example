# Copiar a .env y completar. .env NO debe commitearse.

# URL base de la API del backend (con /api/v1 al final).
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Web Client ID de Google Cloud Console (OAuth consent screen), el mismo
# valor que GOOGLE_CLIENT_ID en backend/.env. Vacío = botón de Google
# deshabilitado en el login.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
