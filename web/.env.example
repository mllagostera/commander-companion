# Copy to .env and fill in. .env must NOT be committed.

# Base URL of the backend API (with /api/v1 at the end).
#
# Since the migration to httpOnly cookies, the process calling the API is
# Nitro, not the browser (see web/README.md), so in Docker Compose this
# value gets overridden by NUXT_API_BASE (Compose's internal hostname).
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Google Cloud Console Web Client ID (OAuth consent screen), the same
# value as GOOGLE_CLIENT_ID in backend/.env. Empty = Google button
# disabled on the login page.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Sentry project DSN for the web client (Project Settings → Client Keys),
# used by both the browser and the Nitro server. It's a separate Sentry
# project from the backend's SENTRY_DSN. Empty = Sentry disabled.
NUXT_PUBLIC_SENTRY_DSN=

# Fraction (0 to 1) of page loads recorded as Sentry performance traces, used
# by both the browser and Nitro. The decision travels to the Go backend in the
# sentry-trace header, so a sampled trace shows browser, Nitro and backend
# spans together. 0 (default) records none; errors in the three are still
# linked by trace ID either way.
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Optional, build time only: with SENTRY_AUTH_TOKEN (plus SENTRY_ORG and
# SENTRY_PROJECT) `npm run build` uploads source maps to Sentry so stack
# traces show the original code. Without it the build skips the upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
