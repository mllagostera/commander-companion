<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent is the *dark* Material theme: CommanderCompanionTheme forces the dark
         color scheme unconditionally, and with a Light parent the window background
         flashed white between the activity opening and Compose drawing its first frame.

         statusBarColor lives here rather than being assigned from Compose because
         Window.setStatusBarColor() is deprecated on API 35+. Declaring it in the theme
         keeps the same result (the app is not edge-to-edge: no screen handles window
         insets, so the system still draws and colors the status bar for targetSdk 34).
         The value must track AppBackground in Color.kt. -->
    <style name="Theme.CommanderCompanion" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
