#!/bin/sh
# Runs the same static checks locally, before pushing, that
# backend-ci.yml / web-ci.yml run in GitHub Actions: gofmt, go vet,
# golangci-lint, "sqlc generate" with no pending diffs, hadolint, eslint,
# typecheck, and the Nuxt build. Goal: don't waste CI minutes on a push
# that we already know, in 1-2 local minutes, will fail lint.
#
# Requires Docker. Setup (once per clone, it doesn't activate on its own):
#   git config core.hooksPath .githooks
#
# To skip the hook for a one-off push: git push --no-verify

set -e

# Git on Windows runs this hook with its embedded MSYS bash, which rewrites
# any argument starting with "/" (like docker run's "-w /app") as if it
# were a Windows path relative to the Git installation. Without this,
# "docker run -v ... -w /app ..." fails with an invalid working directory.
export MSYS_NO_PATHCONV=1

z40=0000000000000000000000000000000000000000
backend_changed=0
web_changed=0
push_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue # remote branch deletion, nothing to check
  push_sha="$local_sha"

  if [ "$remote_sha" = "$z40" ]; then
    # New branch: compare against where it diverges from main (or, if there's
    # no local main reference, against the commit's whole history).
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base="$remote_sha"
  fi

  # Same criterion as dorny/paths-filter in backend-ci.yml/web-ci.yml: a
  # change only counts if there's at least one file under backend/ (or web/)
  # that isn't a .md — so a README-only change doesn't trigger the heavy
  # build/lint, same as in CI.
  changed_files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null)
  if echo "$changed_files" | grep '^backend/' | grep -qv '\.md$'; then backend_changed=1; fi
  if echo "$changed_files" | grep '^web/' | grep -qv '\.md$'; then web_changed=1; fi
done

if [ -z "$push_sha" ]; then
  exit 0
fi

if [ "$backend_changed" = 0 ] && [ "$web_changed" = 0 ]; then
  echo "pre-push: no changes in backend/ or web/, skipping local checks."
  exit 0
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-push: Docker not available, can't run local checks — pushing without verifying."
  exit 0
fi

echo "pre-push: running CI checks locally (backend=$backend_changed web=$web_changed)..."

# mktemp -d lands under /tmp, a purely MSYS path that Docker Desktop (a
# native Windows process) can't resolve as a bind mount even with MSYS_NO_PATHCONV
# leaving it "untouched" — it ends up mounting an empty directory. We use instead
# a directory inside the repo itself (a real Windows path via "pwd -W"), which
# both MSYS bash and docker.exe understand the same way.
repo_root=$(pwd -W 2>/dev/null || pwd)
workdir="$repo_root/.git/pre-push-tmp-$$"
cleanup() { rm -rf "$workdir"; }
trap cleanup EXIT
mkdir -p "$workdir"

# Clean export of the tree that's about to be pushed (line endings exactly as
# they are in the git blob, without the local Windows checkout's core.autocrlf —
# this reproduces what a GitHub Actions Linux runner sees, avoiding false
# gofmt positives from CRLF).
mkdir -p "$workdir/src"
git archive "$push_sha" | tar -x -C "$workdir/src"
# Git for Windows' tar reintroduces CRLF on extraction even if the archive
# itself is in LF — without this, gofmt flags basically the whole repo as
# "unformatted" (a false positive that doesn't exist on CI's Linux runner).
find "$workdir/src" -type f -exec sed -i 's/\r$//' {} +

fail=0

if [ "$backend_changed" = 1 ] && [ -d "$workdir/src/backend" ]; then
  echo "== backend: gofmt / go vet =="
  docker run --rm -v "$workdir/src/backend:/app" -w /app golang:1.25 \
    sh -c 'out=$(gofmt -l .); if [ -n "$out" ]; then echo "$out"; exit 1; fi; go vet ./...' \
    || { echo "pre-push: gofmt/go vet failed"; fail=1; }

  echo "== backend: golangci-lint =="
  docker run --rm -v "$workdir/src/backend:/app" -w /app golangci/golangci-lint:v2.12.2 \
    golangci-lint run --timeout=5m \
    || { echo "pre-push: golangci-lint failed"; fail=1; }

  echo "== backend: sqlc generate (no pending diffs) =="
  cp -r "$workdir/src/backend" "$workdir/backend_sqlc_gen"
  docker run --rm -v "$workdir/backend_sqlc_gen:/src" -w /src sqlc/sqlc:1.27.0 generate >/dev/null
  if ! diff -rq "$workdir/src/backend/internal" "$workdir/backend_sqlc_gen/internal" >/dev/null 2>&1; then
    echo "pre-push: the code generated by sqlc doesn't match — run sqlc generate and commit the result."
    diff -rq "$workdir/src/backend/internal" "$workdir/backend_sqlc_gen/internal" || true
    fail=1
  fi

  echo "== backend: hadolint =="
  docker run --rm -i hadolint/hadolint < "$workdir/src/backend/Dockerfile" \
    || { echo "pre-push: hadolint failed (backend/Dockerfile)"; fail=1; }
fi

if [ "$web_changed" = 1 ] && [ -d "$workdir/src/web" ]; then
  echo "== web: eslint / typecheck / nuxt build =="
  docker run --rm -v "$workdir/src/web:/app" -w /app node:24-slim \
    sh -c 'npm ci --no-audit --no-fund && npm run lint -- --max-warnings=0 && npm run typecheck && npm run build' \
    || { echo "pre-push: web eslint/typecheck/build failed"; fail=1; }

  echo "== web: hadolint =="
  docker run --rm -i hadolint/hadolint < "$workdir/src/web/Dockerfile" \
    || { echo "pre-push: hadolint failed (web/Dockerfile)"; fail=1; }
fi

if [ "$fail" != 0 ]; then
  echo ""
  echo "pre-push: at least one check failed — push cancelled (use 'git push --no-verify' to deliberately skip this)."
  exit 1
fi

echo "pre-push: all green, pushing."
exit 0
