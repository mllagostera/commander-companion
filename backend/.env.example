# Copy to .env (or export as real environment variables) and fill in.
# .env must NOT be committed; this file only documents the expected keys.

# "development" (default) or "production". With APP_ENV=production the server
# refuses to start unless JWT_SECRET and CORS_ALLOWED_ORIGINS are both set
# explicitly, instead of silently falling back to the public dev defaults below.
APP_ENV=development

# Connection to PostgreSQL.
DB_URL=postgres://postgres:postgres@localhost:5432/commander?sslmode=disable

# Port the API listens on.
PORT=8080

# Secret used to sign the JWT access tokens (HS256). Generate your own
# per environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Token durations, in Go's time.ParseDuration format (e.g.: 15m, 720h).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Google Cloud Console Web Client ID (OAuth consent screen), used as the
# expected audience when verifying "Sign in with Google" id_tokens. If left
# empty, POST /auth/google responds 501 Not Implemented.
GOOGLE_CLIENT_ID=908385413195-ktblog02ecjj78f8ghffamuid3iaj6cu.apps.googleusercontent.com

# Allowed origins for CORS, comma-separated (e.g.
# http://localhost:5500,https://app.commandercompanion.com). Empty = "*"
# (any origin), reasonable in dev because the API only uses Bearer tokens,
# never cookies. Restrict it in any real environment.
CORS_ALLOWED_ORIGINS=

# Public URL of the web client (Nuxt), used to build the email verification
# link sent by mail (e.g.: https://app.commandercompanion.com/verify-email?token=...).
WEB_APP_URL=http://localhost:3000

# Whether registration requires confirming the email before being able to log in (see ADR-0012).
# Default false: in the alpha phase there's no point sending the mail or blocking login
# for this, so new accounts start out verified. Set to true when
# the project leaves alpha.
REQUIRE_EMAIL_VERIFICATION=false

# Resend API key (https://resend.com) for sending transactional emails
# (email verification on registration). If left empty, the verification link is
# logged to the console instead of being sent (dev mode, no Resend account needed).
RESEND_API_KEY=

# Sender of the transactional emails (e.g.: "TapeandoCartones <no-reply@tapeandocartones.es>").
# To avoid landing in spam you need to verify your own domain in the
# Resend dashboard (it generates the SPF/DKIM/DMARC records to add to the domain's DNS) — see
# ADR-0012.
EMAIL_FROM=

# Base alias of the Resend Templates for the account verification email (e.g.:
# account-confirmation). There's one Template per locale, aliased "<base>-es",
# "<base>-en" and "<base>-ca"; the backend picks it from the client's language.
# Each must be published and define the USERNAME and VERIFY_URL variables, with
# VERIFY_URL shown as plain text (not as a button/href) — see ADR-0012.
RESEND_VERIFY_EMAIL_TEMPLATE_ID=

# Slack incoming webhook that gets a message for every new account (email/password or
# Google). Create it in Slack under Apps > Incoming Webhooks, pointing at the channel you
# want. If left empty, no notification is sent.
SLACK_SIGNUP_WEBHOOK_URL=

# Git SHA of the deployed revision, reported by GET /health so a caller can tell
# a finished deploy from one still in flight (see ADR-0020). NOT set by hand:
# Render sets it automatically on every service deployed from a Git repo. It is
# only the last-resort source — a binary built with the Dockerfile's GIT_COMMIT
# build argument, or with `go build` inside a git checkout, already carries the
# SHA and ignores this. Unset everywhere else, /health reports "unknown".
RENDER_GIT_COMMIT=

# Sentry project DSN (Project Settings → Client Keys) that unexpected errors
# (opaque 500s) and panics are reported to, tagged with APP_ENV as the
# environment and the deployed Git SHA as the release. Empty = Sentry disabled
# (the default for local development and CI).
SENTRY_DSN=

# Fraction (0 to 1) of API requests recorded as Sentry performance traces.
# 0 (default) records none; errors are still linked to the web client's trace
# either way. Requests coming from the web client follow the sampling decision
# the web already made (NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE), so this rate
# only applies to requests that start here (e.g. the Android app).
SENTRY_TRACES_SAMPLE_RATE=0
