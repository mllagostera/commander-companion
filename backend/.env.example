# Copiar a .env (o exportar como variables de entorno reales) y completar.
# .env NO debe commitearse; este archivo solo documenta las claves esperadas.

# Conexión a PostgreSQL.
DB_URL=postgres://postgres:postgres@localhost:5432/commander?sslmode=disable

# Puerto donde escucha la API.
PORT=8080

# Secreto usado para firmar los access tokens JWT (HS256). Generar uno propio
# por entorno, p. ej.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Duraciones de los tokens, en formato de time.ParseDuration de Go (ej: 15m, 720h).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Web Client ID de Google Cloud Console (OAuth consent screen), usado como
# audience esperada al verificar id_tokens de "Sign in with Google". Si se
# deja vacío, POST /auth/google responde 501 Not Implemented.
GOOGLE_CLIENT_ID=
