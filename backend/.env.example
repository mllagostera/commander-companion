# Copiar a .env (o exportar como variables de entorno reales) y completar.
# .env NO debe commitearse; este archivo solo documenta las claves esperadas.

# Conexión a PostgreSQL.
DB_URL=postgres://postgres:postgres@localhost:5432/commander?sslmode=disable

# Puerto donde escucha la API.
PORT=8080

# Secreto usado para firmar los access tokens JWT (HS256). Generar uno propio
# por entorno, p. ej.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Duraciones de los tokens, en formato de time.ParseDuration de Go (ej: 15m, 720h).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Web Client ID de Google Cloud Console (OAuth consent screen), usado como
# audience esperada al verificar id_tokens de "Sign in with Google". Si se
# deja vacío, POST /auth/google responde 501 Not Implemented.
GOOGLE_CLIENT_ID=908385413195-ktblog02ecjj78f8ghffamuid3iaj6cu.apps.googleusercontent.com

# Orígenes permitidos para CORS, separados por coma (p. ej.
# http://localhost:5500,https://app.commandercompanion.com). Vacío = "*"
# (cualquier origen), razonable en dev porque la API solo usa Bearer tokens,
# nunca cookies. Restringir en cualquier entorno real.
CORS_ALLOWED_ORIGINS=

# URL pública del cliente web (Nuxt), usada para armar el link de verificación de
# email que se manda por mail (ej: https://app.commandercompanion.com/verify-email?token=...).
WEB_APP_URL=http://localhost:3000

# Si el registro exige confirmar el email antes de poder loguearse (ver ADR-0012).
# Default false: en fase alpha no tiene sentido ni mandar el mail ni bloquear el login
# por esto, así que las cuentas nuevas quedan verificadas de alta. Poner en true cuando
# el proyecto salga de alpha.
REQUIRE_EMAIL_VERIFICATION=false

# API key de Resend (https://resend.com) para el envío de mails transaccionales
# (verificación de email al registrarse). Si se deja vacío, el link de verificación se
# loguea por consola en vez de enviarse (modo dev, no requiere cuenta de Resend).
RESEND_API_KEY=

# Remitente de los mails transaccionales (ej: "Commander Companion <noreply@tudominio.com>").
# Para que no caigan en spam hace falta verificar un dominio propio en el dashboard de
# Resend (genera los registros SPF/DKIM/DMARC a agregar en el DNS del dominio) — ver
# ADR-0012.
EMAIL_FROM=

# ID del Template de Resend (dashboard) usado para el mail de verificación de cuenta.
# El template debe estar publicado y definir las variables USERNAME y VERIFY_URL, con
# VERIFY_URL mostrado como texto plano (no como botón/href) — ver ADR-0012.
RESEND_VERIFY_EMAIL_TEMPLATE_ID=
